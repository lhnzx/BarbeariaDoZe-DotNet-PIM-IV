@{
    ViewData["Title"] = "Início";
    ViewData["Ativo"] = "inicio";
    ViewData["Css"] = "index";
}


    <section class="hero">

        <div class="box-principal shadow-lg">
            <div class="logo-centro">
                <img src="~/img/Barbearia_Logo.png" alt="logo centro">
            </div>

            <div class="centro text-center">
                <h1>Barbearia do Ze</h1>
                <p>Tradição e estilo em cada detalhe</p>
                <a asp-controller="Agendar" asp-action="Index" class="btn btn-warning btn-lg">Agendar Horário</a>
            </div>
        </div>

    </section>

    <section class="servicos">
        <h2>Nossos Serviços </h2>

        <div class="carrossel-servicos">
        
            <div class="card-servico shadow-lg">
                <h3>Corte</h3>
                <p>Corte moderno e acabamento profissional.</p>
                <a asp-controller="Servicos" asp-action="Index" class="btn btn-warning">Ver</a>
            </div>
            
            <div class="card-servico shadow-lg">
                <h3>Barba</h3>
                <p>Modelagem completa e hidratação.<p>
                <a asp-controller="Servicos" asp-action="Index" class="btn btn-warning">Ver</a>
            </div>
      
            <div class="card-servico shadow-lg">
                <h3>Sobrancelha</h3>
                <p>Detalhamento para um visual mais limpo.</p>
                <a asp-controller="Servicos" asp-action="Index" class="btn btn-warning">Ver</a>
            </div>
       
            <div class="card-servico shadow-lg">
                <h3>Bigode</h3>
                <p>Acabamento premium e alinhado.</p>
                <a asp-controller="Servicos" asp-action="Index" class="btn btn-warning">Ver</a>
            </div>

            <div class="card-servico shadow-lg">
                <h3>Mais opções</h3>
                <p>Clique aqui para ver tudo.</p>
                <a asp-controller="Servicos" asp-action="Index" class="btn btn-warning">Ver todos os serviços</a>
            </div>
        </div>

    </section>

    <!-- AVALIACOES -->
    <section class="avaliacoes">
        <h2>Avaliações dos Clientes</h2>
        
        <div class="container-avaliacoes">
            
            <div class="card-avaliacao shadow-lg">
                <h3>
                    <i class="bi bi-person-circle"></i>
                    João Silva
                </h3>
                <span>⭐⭐⭐⭐⭐</span>
                <p>Atendimento excelente e corte impecável.</p>
            </div>
         
            <div class="card-avaliacao shadow-lg">
                <h3>
                    <i class="bi bi-person-circle"></i> <!--icon de perfil-->
                    Marcos Oliveira
                </h3>
                <span>⭐⭐⭐⭐⭐</span>
                <p>Melhor barbearia da região.</p>
            </div>

            <div class="card-avaliacao shadow-lg">
                <h3>  
                    <i class="bi bi-person-circle"></i>
                    Lucas Santos
                </h3>
                <span>⭐⭐⭐⭐⭐</span>
                <p>Serviço rápido e profissional.</p>
            </div>

             <div class="card-avaliacao shadow-lg">
                <h3>
                    <i class="bi bi-person-circle"></i>
                    Arnaldo Rocha
                </h3>
                <span>⭐⭐⭐⭐⭐</span>
                <p>O barbeiro entendeu exatamente o que eu queria e o corte ficou impecável.</p>
            </div>
        </div>

    </section>

    