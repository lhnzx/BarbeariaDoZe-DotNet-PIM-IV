@{
    ViewData["Title"] = "Contato";
    ViewData["Ativo"] = "contato";
    ViewData["Css"] = "style";
}


<div class="container">

    <h2 class="section-title">Contato</h2>

    <div class="contact-box">

        <div class="contact-header">

            <div class="contact-title">
                 ENTRE EM CONTATO
            </div>

            <div class="contact-text">
                Estamos aqui para atender você
            </div>

        </div>

        <div class="contact-card">

            <h3>
                <span class="square"></span>
                LOCALIZAÇÃO
            </h3>

            <div class="info-box">
                Rua das Flores, 123
            </div>

            <div class="info-box">
                Centro - Ribeirão Preto, SP
            </div>

            <div class="info-box">
                CEP: 01234-567
            </div>

        <a href="https://www.google.com/maps?q=Rua+das+Flores+123+Ribeirao+Preto+SP" 
   target="_blank"
   class="map-button">
    VER NO MAPA
</a>
        </div>

        <div class="contact-card">

            <h3>
                <span class="square"></span>
                HORÁRIO
            </h3>

            <div class="hour-box">
                <span>Segunda à Sexta</span>
                <strong>09:00 - 17:00</strong>
            </div>

            <div class="hour-box">
                <span>Sábado</span>
                <strong>09:00 - 14:00</strong>
            </div>

            <div class="hour-box">
                <span>Domingo</span>
                <strong>Fechado</strong>
            </div>

        </div>

    </div>

    <h2 class="section-title">Canais de Atendimento</h2>

    <div class="contact-card">

        <div class="channel-box">

            <div class="icon-box">
                <i class="bi bi-telephone"></i> <!--grazi: adicionei icon telefone-->
            </div>

            <div class="channel-content">

                <h3>TELEFONE</h3>

                <div class="info-box">
                    (16) 98765-4321
                </div>

                <a href="tel:+5516987654321" class="channel-button">
                    Ligar Agora
                </a>

            </div>

        </div>

        <div class="channel-box">

            <div class="icon-box">
                <i class="bi bi-whatsapp"></i>  <!--grazi: adicionei icon do whatsapp-->
            </div>

            <div class="channel-content">

                <h3>WHATSAPP</h3>

                <div class="info-box">
                    (16) 98765-4321
                </div>

                <a href="https://wa.me/5516987654321" class="channel-button">
                    Abrir WhatsApp
                </a>

            </div>

        </div>

        <div class="channel-box">

            <div class="icon-box">
                <i class="bi bi-envelope"></i> <!--grazi: adicionei icon envelope-->
            </div>

            <div class="channel-content">

                <h3>E-MAIL</h3>

                <div class="info-box">
                    contato@@barbeariadoze.com
                </div>

                <a href="mailto:contato@@barbeariadoze.com" class="channel-button">
                    Enviar E-mail
                </a>

            </div>

        </div>

        <div class="channel-box">

            <div class="icon-box">
                <i class="bi bi-instagram"></i> <!--grazi: adidiconei icon insta-->
            </div>

            <div class="channel-content">

                <h3>INSTAGRAM</h3>

                <div class="info-box">
                    @@barbeariadoze
                </div>

                <a href="#" class="channel-button">
                    Abrir Perfil
                </a>

            </div>

        </div>

    </div>

    <h2 class="section-title">Localização</h2>

    <div class="map-section">

    

<iframe 
src="https://maps.google.com/maps?q=Rua%20das%20Flores%20123%20Ribeirao%20Preto%20SP&t=&z=17&ie=UTF8&iwloc=&output=embed"
width="100%" 
height="400" 
style="border:0; border-radius:15px;">
</iframe>
    </div>

    <div class="whatsapp-section">

        <div class="whatsapp-icon">
            <i class="bi bi-whatsapp"></i> <!--grazi: adicionei-->
        </div>

        <h2>WHATSAPP</h2>

        <p>
            Atendimento rápido pelo WhatsApp
        </p>

        <a href="https://wa.me/5516987654321" target="_blank">
            ABRIR WHATSAPP
        </a>

    </div>

</div>

