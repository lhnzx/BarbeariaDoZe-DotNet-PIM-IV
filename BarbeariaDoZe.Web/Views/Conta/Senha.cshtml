@model RecuperacaoViewModel
@{ Layout = "_LayoutSimples"; ViewData["Title"] = "Recuperar senha"; ViewData["Css"] = "senha"; }
<form method="post">
    <img src="~/img/Barbearia_Logo.png" alt="Barbearia do Zé" class="logo-login">
    <h1>Esqueci a senha</h1>
    <p class="descricao">Informe o e-mail da sua conta para receber o link de redefinição de senha.</p>

    @if (Model.LinkDemonstracao is not null)
    {
        <p class="alerta ok" role="status">
            Modo demonstração (sem servidor de e-mail configurado).<br>
            Em uso real, este link seria enviado por e-mail:<br>
            <a href="@Model.LinkDemonstracao">Clique aqui para criar a nova senha</a>
        </p>
    }
    else if (Model.Mensagem is not null)
    {
        <p class="alerta @(Model.Erro ? "erro" : "ok")" role="status">@Model.Mensagem</p>
    }

    <div class="input-box">
        <input asp-for="Email" type="email" placeholder="E-mail" aria-label="E-mail" required>
        <i class="bx bxs-envelope"></i>
    </div>
    <button type="submit" class="login">Enviar link</button>
    <div class="register-link"><p><a asp-action="Login">Voltar ao login</a></p></div>
</form>
